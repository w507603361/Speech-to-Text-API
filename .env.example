# Copy to .env and replace passwords before first startup.
MYSQL_DATABASE=speech_api
MYSQL_USER=speech_api
MYSQL_PASSWORD=replace_with_random_password
MYSQL_ROOT_PASSWORD=replace_with_another_random_password
APP_PORT=8000
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60
